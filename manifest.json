{
    "manifest_version": 3,
    "name": "SK-toolbox",
    "version": "1.0",
    "permissions": [
        "sidePanel",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://cad.stilkuhni.com/*"
    ],
    "icons": {
        "48": "ext/icon.png"
    },
    "action": {
        "default_icon": "ext/icon.png",
        "default_title": "Панель инструментов SK-toolbox"
    },
    "side_panel": {
        "default_path": "ext/panel/index.html"
    },
    "background": {
        "service_worker": "ext/worker/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://cad.stilkuhni.com/*"
            ],
            "js": [
                "ext/page/data-copier.js",
                "ext/page/index.js"
            ]
        }
    ]
}